# ===== AI解析（Google Gemini API / Google AI Studio）=====
# APIキーの取得: https://aistudio.google.com/apikey
# サーバー側でのみ使用します。NEXT_PUBLIC_ を付けないこと。
GEMINI_API_KEY=

# 使用モデル（任意）。未指定なら gemini-3.5-flash-lite（無料枠・画像入力対応の軽量モデル）
# ※ gemini-1.5-flash / gemini-2.0-flash は終了済みで使えません。
# 精度が足りない場合の候補: gemini-3.6-flash, gemini-3.8-flash（いずれも無料枠あり。上限は低め）
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== 乱用対策（任意）=====
# 1IPあたり 10分間に許可する解析回数（既定 8）
RATE_LIMIT_PER_10MIN=8
# サーバーインスタンス全体での1日あたり上限（既定 400）
DAILY_LIMIT=400

# ===== 広告（Google AdSense）=====
# 未設定の間は「広告枠」のプレースホルダーが表示されます
# 例: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# 広告ユニットごとのスロットID（AdSense管理画面で発行）
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
